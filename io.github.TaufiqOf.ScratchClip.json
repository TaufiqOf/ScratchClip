{
  "app-id": "io.github.TaufiqOf.ScratchClip",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.dotnet10"
  ],
  "command": "scratchclip",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=system-bus",
    "--socket=session-bus",
    "--device=all",
    "--filesystem=home",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.kde.StatusNotifier"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/man",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "libsecret",
      "buildsystem": "meson",
      "config-opts": [
        "-Dlibdir=lib",
        "-Dvapi=false",
        "-Dgtk_doc=false",
        "-Dintrospection=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/libsecret/0.21/libsecret-0.21.4.tar.xz",
          "sha256": "163d08d783be6d4ab9a979ceb5a4fecbc1d9660d3c34168c581301cd53912b20"
        }
      ]
    },
    {
      "name": "libxmu",
      "buildsystem": "autotools",
      "sources": [
        {
          "type": "archive",
          "url": "https://www.x.org/archive/individual/lib/libXmu-1.1.4.tar.xz",
          "sha256": "210de3ab9c3e9382572c25d17c2518a854ce6e2c62c5f8315deac7579e758244"
        }
      ]
    },
    {
      "name": "xclip",
      "buildsystem": "autotools",
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/astrand/xclip/archive/refs/tags/0.13.tar.gz",
          "sha256": "ca5b8804e3c910a66423a882d79bf3c9450b875ac8528791fb60ec9de667f758"
        }
      ]
    },
    {
      "name": "xdotool",
      "buildsystem": "simple",
      "build-commands": [
        "make",
        "make install PREFIX=/app"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/jordansissel/xdotool/archive/refs/tags/v3.20211022.1.tar.gz",
          "sha256": "82b15a944a5e82fee15e0f6116bd9f642bc3d0bb6989fc0ca5ad9dfe35de0847"
        }
      ]
    },
    {
      "name": "scratchclip",
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
          "DOTNET_ROOT": "/usr/lib/sdk/dotnet10",
          "PATH": "/usr/lib/sdk/dotnet10/bin:/usr/bin:/bin",
          "NUGET_PACKAGES": "/run/build/scratchclip/nuget-packages"
        }
      },
      "build-commands": [
        "mkdir -p /run/build/scratchclip/nuget-packages",
        "/usr/lib/sdk/dotnet10/bin/dotnet restore ScratchClip/ScratchClip.csproj --source nuget-sources --packages /run/build/scratchclip/nuget-packages",
        "/usr/lib/sdk/dotnet10/bin/dotnet publish -c Release --self-contained false --no-restore -o /app/bin ScratchClip/ScratchClip.csproj",
        "find /run/build/scratchclip/nuget-packages -type f \\( -name '*skeychain*.so*' -o -name '*treesitter*.so*' \\) -exec cp -f {} /app/bin/ \\; 2>/dev/null || true",
        "ln -sf /app/bin/ScratchClip /app/bin/scratchclip",
        "chmod +x /app/bin/ScratchClip /app/bin/scratchclip"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "."
        },
        "nuget-sources.json"
      ],
      "post-install": [
        "install -Dm644 io.github.TaufiqOf.ScratchClip.desktop /app/share/applications/io.github.TaufiqOf.ScratchClip.desktop",
        "install -Dm644 io.github.TaufiqOf.ScratchClip.metainfo.xml /app/share/metainfo/io.github.TaufiqOf.ScratchClip.metainfo.xml",
        "install -Dm644 ScratchClip/Assets/icon-light.png /app/share/icons/hicolor/512x512/apps/io.github.TaufiqOf.ScratchClip.png",
        "install -Dm644 -t /app/share/licenses/io.github.TaufiqOf.ScratchClip LICENSE 2>/dev/null || true"
      ]
    }
  ]
}