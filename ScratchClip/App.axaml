<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ScratchClip.App"
             xmlns:scratchClip="clr-namespace:ScratchClip"
             RequestedThemeVariant="Default">

    <Application.Resources>

        <!-- Font Awesome 7 Solid -->
        <FontFamily x:Key="FontAwesome">
            avares://ScratchClip/Assets/Fonts/Poppins-Regular.ttf#Poppins
        </FontFamily>

        <StorageFileToReadStreamConverter x:Key="InverseBooleanConverter" />

    </Application.Resources>

    <Application.DataTemplates>
        <scratchClip:ViewLocator />
    </Application.DataTemplates>

    <TrayIcon.Icons>
        <TrayIcons>

            <TrayIcon Icon="avares://ScratchClip/Assets/icon-dark.ico"
                      ToolTipText="ScratchClip"
                      Clicked="TrayIcon_OnClicked">

                <TrayIcon.Menu>
                    <NativeMenu>

                        <NativeMenuItem Header="Show App"
                                        Click="ShowApp_OnClick" />

                        <NativeMenuItemSeparator />

                        <NativeMenuItem Header="Exit"
                                        Click="ExitApp_OnClick" />

                    </NativeMenu>
                </TrayIcon.Menu>

            </TrayIcon>

        </TrayIcons>
    </TrayIcon.Icons>

    <Application.Styles>

        <FluentTheme>

            <FluentTheme.Palettes>

                <ColorPaletteResources
                    x:Key="Light"
                    Accent="{DynamicResource SystemAccentColor}" />

                <ColorPaletteResources
                    x:Key="Dark"
                    Accent="{DynamicResource SystemAccentColor}" />

            </FluentTheme.Palettes>

        </FluentTheme>

        <StyleInclude
            Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <!-- Font Awesome icon style -->
        <Style Selector="TextBlock.icon">

            <Setter Property="FontFamily"
                    Value="{DynamicResource FontAwesome}" />

            <Setter Property="FontSize"
                    Value="18" />

        </Style>

    </Application.Styles>

</Application>