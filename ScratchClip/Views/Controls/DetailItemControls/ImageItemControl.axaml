<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ScratchClip.Models"
             xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             x:Class="ScratchClip.Views.Controls.DetailItemControls.ImageItemControl"
             x:DataType="models:ImageClipboardItem">

    <Border CornerRadius="6"
            ClipToBounds="True">
        <Border Padding="10"
                CornerRadius="8"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="10">

                <!-- Icon -->
                <Border Width="42"
                        Height="42"
                        CornerRadius="8"
                        VerticalAlignment="Top"
                        Background="Transparent">

                    <avalonia:FluentIcon Icon="Image"
                                         FontSize="40"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                </Border>
                <Image Grid.Column="1" Source="{Binding Image}"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            </Grid>
   

        </Border>
    </Border>

</UserControl>