<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScratchClip.Views.Controls.SettingsControls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ScratchClip.ViewModels"
             xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:DataType="viewModels:SettingsViewModel"
             x:Class="ScratchClip.Views.Controls.SettingsControls.ExportSettingsControl">
    <Border Classes="settingsCard">
        <StackPanel Spacing="16">
            <StackPanel Spacing="2">
                <TextBlock Text="Export History" Classes="settingTitle" />
                <TextBlock Text="Export your clipboard history items into an external backup file."
                           Classes="description" />
            </StackPanel>

            <Separator Height="1"
                       Background="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}" />

            <!-- Item Selectors -->
            <StackPanel Spacing="8">
                <TextBlock Text="Included Item Types" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Text Items"
                               VerticalAlignment="Center" FontSize="13" />
                    <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                  IsChecked="{Binding WillExportTextItems}" OffContent=""
                                  OnContent="" HorizontalAlignment="Right" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Image Items"
                               VerticalAlignment="Center" FontSize="13" />
                    <ToggleSwitch Grid.Row="1" Grid.Column="1"
                                  IsChecked="{Binding WillExportImageItems}" OffContent=""
                                  OnContent="" HorizontalAlignment="Right" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="File &amp; Storage Items"
                               VerticalAlignment="Center" FontSize="13" />
                    <ToggleSwitch Grid.Row="2" Grid.Column="1"
                                  IsChecked="{Binding WillExportStorageItems}" OffContent=""
                                  OnContent="" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>

            <Separator Height="1"
                       Background="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}" />

            <!-- Destination File Selection -->
            <StackPanel Spacing="8">
                <TextBlock Text="Destination Path" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="ExportPathTextBox"
                             Text="{Binding ExportFilePath, Mode=TwoWay}"
                             Watermark="Select destination file..."
                             IsReadOnly="True"
                             VerticalContentAlignment="Center" />

                    <Button Grid.Column="1"
                            x:Name="FileSelectButton"
                            Command="{Binding SelectFileCommand}"
                            ToolTip.Tip="Browse destination path"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <avalonia:FluentIcon Icon="Folder" />
                            <TextBlock Text="Browse" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Export Action Button -->
            <Button x:Name="ExportButton"
                    Command="{Binding ExportCommand}"
                    Classes="actionButton accent"
                    HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <avalonia:FluentIcon Icon="ArrowExport" />
                    <TextBlock Text="Export History" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

        </StackPanel>
    </Border>
</UserControl>