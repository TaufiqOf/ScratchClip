<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ScratchClip.Models"
             x:Class="ScratchClip.Views.Controls.LightItemControls.ImageItemControl"
             x:DataType="models:ImageClipboardItem">

    <Border Padding="4"
            CornerRadius="4"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">

        <Image Source="{Binding Image}"
               Height="64"
               Stretch="Uniform"
               HorizontalAlignment="Left" />

    </Border>

</UserControl>