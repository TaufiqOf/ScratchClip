<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             xmlns:models="clr-namespace:ScratchClip.Models"
             x:Name="TextControl"
             x:Class="ScratchClip.Views.Controls.LightItemControls.TextItemControl"
             x:DataType="models:TextClipboardItem">

    <UserControl.Styles>

        <!-- Password reveal button -->
        <Style Selector="ToggleButton.listRevealBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
        </Style>

        <Style Selector="ToggleButton.listRevealBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background"
                    Value="{DynamicResource SystemControlHighlightListLowBrush}" />
        </Style>

        <Style Selector="ToggleButton.listRevealBtn:checked /template/ ContentPresenter">
            <Setter Property="Background"
                    Value="Transparent" />
        </Style>

    </UserControl.Styles>


    <!-- ======================================= -->
    <!-- Text-specific UI -->
    <!-- ======================================= -->

    <Grid ColumnDefinitions="*,Auto"
          ColumnSpacing="4">

        <!-- ================================= -->
        <!-- Content -->
        <!-- ================================= -->

        <Grid Grid.Column="0">

            <!-- Normal / non-password text -->
            <SelectableTextBlock Text="{Binding DisplayText}"
                                 FontSize="12"
                                 Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                 TextWrapping="Wrap">

                <SelectableTextBlock.IsVisible>
                    <Binding Path="!IsPassword" />
                </SelectableTextBlock.IsVisible>

            </SelectableTextBlock>


            <!-- Revealed password -->
            <SelectableTextBlock Text="{Binding Text}"
                                 FontSize="12"
                                 Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                 TextWrapping="Wrap">

                <SelectableTextBlock.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsPassword" />
                        <Binding Path="#ListRevealToggle.IsChecked" />
                    </MultiBinding>
                </SelectableTextBlock.IsVisible>

            </SelectableTextBlock>


            <!-- Masked password -->
            <TextBlock Text="••••••••••••"
                       FontSize="12"
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">

                <TextBlock.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsPassword" />
                        <Binding Path="!#ListRevealToggle.IsChecked" />
                    </MultiBinding>
                </TextBlock.IsVisible>

            </TextBlock>

        </Grid>


        <!-- ================================= -->
        <!-- Password Reveal Button -->
        <!-- ================================= -->

        <ToggleButton Grid.Column="1"
                      x:Name="ListRevealToggle"
                      Classes="listRevealBtn"
                      IsVisible="{Binding IsPassword}"
                      ToolTip.Tip="Toggle Password Visibility"
                      VerticalAlignment="Top">

            <Panel>

                <!-- Eye when hidden -->
                <avalonia:FluentIcon Icon="Eye"
                                     FontSize="13"
                                     IsVisible="{Binding !$parent[ToggleButton].IsChecked}" />

                <!-- EyeOff when visible -->
                <avalonia:FluentIcon Icon="EyeOff"
                                     FontSize="13"
                                     IsVisible="{Binding $parent[ToggleButton].IsChecked}" />

            </Panel>

        </ToggleButton>

    </Grid>

</UserControl>