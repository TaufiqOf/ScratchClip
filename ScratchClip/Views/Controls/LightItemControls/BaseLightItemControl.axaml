<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             xmlns:models="clr-namespace:ScratchClip.Models"
             xmlns:converters="clr-namespace:ScratchClip.Converters"
             x:Name="BaseControl"
             x:DataType="models:AClipboardItem"
             x:Class="ScratchClip.Views.Controls.LightItemControls.BaseLightItemControl">
    <UserControl.Resources>
        <converters:ToUpperConverter x:Key="ToUpperConverter" />
        <converters:PinIconConverter x:Key="PinIconConverter" />
    </UserControl.Resources>
    <Grid>
        <Border Padding="8"
                CornerRadius="6"
                DoubleTapped="OnDoubleTapped"
                Background="{DynamicResource SystemControlBackgroundAltMediumBrush}">

            <Grid RowDefinitions="Auto,*,Auto"
                  RowSpacing="4"
                  ColumnSpacing="8">


                <Grid Grid.Row="0" RowSpacing="4" ColumnDefinitions="Auto,*">
                    <!-- ================================= -->
                    <!-- Index -->
                    <!-- ================================= -->
                    <Border Grid.Column="0"
                            Width="22"
                            Height="22"
                            VerticalAlignment="Top"
                            CornerRadius="3"
                            Background="{DynamicResource SystemControlHighlightAccentBrush}">

                        <TextBlock Text="{Binding DisplayIndex}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SystemControlHighlightAltBaseHighBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                    </Border>


                    <!-- ================================= -->
                    <!-- Timestamp -->
                    <!-- ================================= -->

                    <TextBlock Grid.Column="1"
                               Margin="5,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding Timestamp,
                                          StringFormat='{}{0:HH:mm:ss - MMM dd}'}"
                               FontSize="10"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                    <!-- ================================= -->
                    <!-- Item-specific content -->
                    <!-- ================================= -->

                    <ContentPresenter Grid.Column="0"
                                      MaxHeight="150"
                                      Content="{Binding ItemContent,
                                                    ElementName=BaseControl}" />

                    <!-- ================================= -->
                    <!-- Actions -->
                    <!-- ================================= -->

                    <StackPanel Grid.Column="1"
                                Margin="5,0,0,0"
                                Orientation="Vertical"
                                Spacing="2"
                                VerticalAlignment="Top">

                        <!-- Optional actions -->
                        <ContentPresenter
                            Content="{Binding ExtraActions,
                                                        ElementName=BaseControl}" />
                        <!-- Pin -->
                        <ToggleButton IsChecked="{Binding IsPinned, Mode=TwoWay}"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="3"
                                Padding="5"
                                Width="26"
                                Height="26"
                                
                                ToolTip.Tip="Toggle Pinned(Ctrl+P)">

                            <avalonia:FluentIcon
                                Icon="{Binding IsPinned, Converter={StaticResource PinIconConverter}}"
                                FontSize="14" />

                        </ToggleButton>
                        <!-- Open -->
                        <Button Command="{Binding OpenCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="3"
                                Padding="5"
                                Width="26"
                                Height="26"
                                ToolTip.Tip="Open(Ctrl+O)">

                            <avalonia:FluentIcon
                                Icon="Open"
                                FontSize="14" />

                        </Button>
                        <!-- Common Save As -->
                        <Button Command="{Binding SaveAsCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="3"
                                Padding="5"
                                Width="26"
                                Height="26"
                                ToolTip.Tip="Save To File(Ctrl+S)">

                            <avalonia:FluentIcon Icon="Save"
                                                 FontSize="14" />

                        </Button>
                        <!-- Common Edit -->
                        <Button Command="{Binding EditCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="3"
                                Padding="5"
                                Width="26"
                                Height="26"
                                ToolTip.Tip="Edit(Ctrl+E)">

                            <avalonia:FluentIcon Icon="Edit"
                                                 FontSize="14" />

                        </Button>
                        <!-- Common delete -->
                        <Button Command="{Binding DeleteCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="3"
                                Padding="5"
                                Width="26"
                                Height="26"
                                ToolTip.Tip="Delete(Del)">

                            <avalonia:FluentIcon Icon="Delete"
                                                 FontSize="14" />

                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ================================= -->
                <!-- Tags -->
                <!-- ================================= -->

                <ItemsControl Grid.Row="2"
                              ItemsSource="{Binding Tags}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>


                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    CornerRadius="3"
                                    Padding="5,1">

                                <TextBlock Text="{Binding Converter={StaticResource ToUpperConverter}}"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />

                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>

</UserControl>