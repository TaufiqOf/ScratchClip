<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ScratchClip.Models"
             xmlns:storageTypeControls="clr-namespace:ScratchClip.Views.Controls.StorageTypeControls"
             x:Class="ScratchClip.Views.Controls.LightItemControls.StorageItemsControl"
             x:DataType="models:StorageClipboardItem">
    <Border Padding="4"
            CornerRadius="4"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <storageTypeControls:StorageItemsViewerControl DataContext="{Binding }" />
    </Border>
</UserControl>