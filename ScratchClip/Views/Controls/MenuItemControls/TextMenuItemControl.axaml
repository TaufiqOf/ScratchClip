<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ScratchClip.Models"
             xmlns:converters="clr-namespace:ScratchClip.Converters"
             x:DataType="models:TextClipboardItem"
             x:Class="ScratchClip.Views.Controls.MenuItemControls.TextMenuItemControl">

    <UserControl.Resources>
        <converters:OneLineConverter x:Key="OneLineConverter" />
    </UserControl.Resources>

    <TextBlock VerticalAlignment="Center"
               Margin="5,0,0,0"
               TextTrimming="CharacterEllipsis"
               FontSize="12"
               Text="{Binding DisplayText,
                              Converter={StaticResource OneLineConverter}}" />

</UserControl>