<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ScratchClip.Models"
             x:DataType="models:ImageClipboardItem"
             x:Class="ScratchClip.Views.Controls.MenuItemControls.ImageMenuItemControl">

    <Grid ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="5">

        <TextBlock Text="[Image]"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource ButtonForegroundDisabled}" />

        <Image Grid.Column="1"
               Source="{Binding Image}"
               HorizontalAlignment="Left"
               Width="32"
               Height="32"
               Stretch="Uniform" />

    </Grid>

</UserControl>