<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:ScratchClip.ViewModels"
             xmlns:models="clr-namespace:ScratchClip.Models"
             xmlns:menuItemControls="clr-namespace:ScratchClip.Views.Controls.MenuItemControls"
             x:DataType="viewModels:ListViewModel"
             x:Class="ScratchClip.Views.Controls.MenuViewModeControl">

    <UserControl.Styles>
        <!-- Flat Reveal Button Styling -->
        <Style Selector="ToggleButton.listRevealBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
        </Style>
        <Style Selector="ToggleButton.listRevealBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
        </Style>
        <Style Selector="ToggleButton.listRevealBtn:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <!-- Clipboard List -->
    <Grid Margin="6,2,6,6">
        <ListBox x:Name="ListBox"
                 ItemsSource="{Binding FilteredHistory}"
                 SelectionMode="Single"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <ListBox.DataTemplates>
                <!-- Text -->
                <DataTemplate x:DataType="models:TextClipboardItem">
                    <menuItemControls:BaseMenuItemControl>
                        <menuItemControls:BaseMenuItemControl.ItemContent>
                            <menuItemControls:TextMenuItemControl />
                        </menuItemControls:BaseMenuItemControl.ItemContent>
                    </menuItemControls:BaseMenuItemControl>
                </DataTemplate>
                <!-- Image -->
                <DataTemplate x:DataType="models:ImageClipboardItem">
                    <menuItemControls:BaseMenuItemControl>
                        <menuItemControls:BaseMenuItemControl.ItemContent>
                            <menuItemControls:ImageMenuItemControl />
                        </menuItemControls:BaseMenuItemControl.ItemContent>
                    </menuItemControls:BaseMenuItemControl>
                </DataTemplate>
                <!-- Storage -->
                <DataTemplate x:DataType="models:StorageClipboardItem">
                    <menuItemControls:BaseMenuItemControl>
                        <menuItemControls:BaseMenuItemControl.ItemContent>
                            <menuItemControls:StorageMenuItemControl />
                        </menuItemControls:BaseMenuItemControl.ItemContent>
                    </menuItemControls:BaseMenuItemControl>
                </DataTemplate>
            </ListBox.DataTemplates>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="2" />
                    <Setter Property="Margin" Value="2" />
                </Style>
            </ListBox.Styles>
        </ListBox>
    </Grid>
</UserControl>