<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:viewModels="clr-namespace:ScratchClip.ViewModels"
    xmlns:converters="clr-namespace:ScratchClip.Converters"
    x:Class="ScratchClip.Views.Page.MainPageControl"
    x:DataType="viewModels:MainViewModel">
    <UserControl.Resources>
        <converters:PinIconConverter x:Key="PinIconConverter" />
    </UserControl.Resources>
    <Grid
        RowDefinitions="Auto,Auto,Auto,Auto,*"
        Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

        <!-- ========================================================= -->
        <!-- Top toolbar                                                -->
        <!-- ========================================================= -->

        <Border
            Grid.Row="0"
            Padding="10,8">

            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Application -->
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="8">

                    <Border
                        Width="32"
                        Height="32"
                        CornerRadius="7"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">

                        <Image
                            x:Name="LogoImage"
                            Source="avares://ScratchClip/Assets/icon-dark.ico"
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stretch="Uniform"/>
                    </Border>

                    <TextBlock
                        Text="SCRATCHCLIP"
                        FontSize="15"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

                </StackPanel>


                <!-- Main actions -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"

                    Spacing="3"
                    Margin="16,0">

                    <!-- Clear clipboard -->
                    <Button
                        Command="{Binding ClearClipboardCommand}"
                        Width="32"
                        Height="32"
                        ToolTip.Tip="Clear Clipboard">

                        <avalonia:FluentIcon
                            Icon="ClipboardChatEmpty"
                            FontSize="16"/>

                    </Button>


                    <!-- Clear history -->
                    <Button
                        Command="{Binding ClearHistoryCommand}"
                        Width="32"
                        Height="32"
                        ToolTip.Tip="Clear Clipboard History">

                        <avalonia:FluentIcon
                            Icon="Delete"
                            FontSize="16"/>

                    </Button>


                    <!-- Lock -->
                    <Button
                        x:Name="LockButton"
                        Command="{Binding LockCommand}"
                        Width="32"
                        Height="32"
                        ToolTip.Tip="Lock Clipboard(Alt+L)">

                        <avalonia:FluentIcon
                            Icon="LockClosed"
                            FontSize="16"/>

                    </Button>


                    <!-- Separator -->
                    <Border
                        Width="1"
                        Height="22"
                        Margin="6,0"
                        Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>


                    <!-- Clipboard monitoring -->
                    <ToggleButton
                        IsChecked="{Binding IsMonitoringClipboard}"
                        ToolTip.Tip="Toggle Clipboard Monitoring(Alt+M)"
                        Height="32">

                        <StackPanel
                            Orientation="Horizontal">
                            <avalonia:FluentIcon
                                Icon="Eye"
                                FontSize="16"/>
                            <TextBlock
                                Text="Monitor"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </ToggleButton>


                    <!-- Pin -->
                    <ToggleButton
                        IsChecked="{Binding IsPinned}"
                        Width="32"
                        Height="32"
                        ToolTip.Tip="Toggle Pinned(Alt+Q)">

                        <avalonia:FluentIcon
                            Icon="{Binding IsPinned, Converter={StaticResource PinIconConverter}}"
                            FontSize="16"/>

                    </ToggleButton>


                    <!-- Mode -->
                    <ComboBox
                        ItemsSource="{Binding ModeOptions}"
                        SelectedItem="{Binding SelectedMode}"
                        MinWidth="110"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"/>

                </StackPanel>


                <!-- Settings -->
                <Button
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="32"
                    Height="32"
                    Command="{Binding OpenSettingsCommand}"
                    ToolTip.Tip="Settings(Alt+P)">

                    <avalonia:FluentIcon
                        Icon="Settings"
                        FontSize="16"/>

                </Button>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- Toolbar separator                                          -->
        <!-- ========================================================= -->

        <Border
            Grid.Row="1"
            Height="1"
            Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>


        <!-- ========================================================= -->
        <!-- Filter / Search                                            -->
        <!-- ========================================================= -->

        <Border
            Grid.Row="2"
            Padding="10,8">

            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Tag filter -->
                <Grid
                    Grid.Column="0"
                    ColumnDefinitions="*,Auto"
                    Margin="0,0,10,0">

                    <DropDownButton
                        Grid.Column="0"
                        MinWidth="180"
                        Height="32"
                        HorizontalAlignment="Stretch"
                        Content="{Binding SelectedTagsSummary}">

                        <DropDownButton.Flyout>

                            <Flyout
                                Placement="BottomEdgeAlignedLeft">
                                <Border
                                    MinWidth="240"
                                    MaxHeight="280">
                                    <ScrollViewer
                                        MaxHeight="260">
                                        <ItemsControl
                                            ItemsSource="{Binding TagFilterOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox
                                                        Content="{Binding Name}"
                                                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                        Margin="0,0"/>

                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>


                    <Button
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Margin="4,0,0,0"
                        Command="{Binding ClearTagFilterCommand}"
                        ToolTip.Tip="Clear Tag Filter">

                        <avalonia:FluentIcon
                            Icon="Dismiss"
                            FontSize="15"/>

                    </Button>

                </Grid>


                <!-- Search -->
                <Grid
                    Grid.Column="1"
                    MinWidth="180"
                    MaxWidth="600"
                    Height="32"
                    HorizontalAlignment="Stretch"
                    ColumnDefinitions="*,Auto">

                    <TextBox
                        x:Name="SearchTextBox"
                        Grid.Column="0"
                        Height="32"
                        Text="{Binding SearchText, Mode=TwoWay}"
                        GotFocus="SearchTextBoxOnGotFocus"
                        LostFocus="SearchTextBoxOnLostFocus"
                        PlaceholderText="Search clipboard history..."
                        VerticalContentAlignment="Center"/>

                    <Button
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Margin="-38,0,2,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding ClearSearchCommand}"
                        ToolTip.Tip="Clear Search">

                        <avalonia:FluentIcon
                            Icon="Dismiss"
                            FontSize="14"/>

                    </Button>
                </Grid>
            </Grid>
        </Border>


        <!-- ========================================================= -->
        <!-- Content separator                                          -->
        <!-- ========================================================= -->

        <Border
            Grid.Row="3"
            Height="1"
            Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>



        <!-- ========================================================= -->
        <!-- Clipboard content                                          -->
        <!-- ========================================================= -->

        <Border
            Grid.Row="4"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BoxShadow="
        inset 0 8 14 0 #A0000000,
        inset 0 -8 14 0 #A0000000,
        inset 0 1 3 0 #35FFFFFF,
        inset 0 -1 3 0 #20000000">

            <ContentControl
                x:Name="ContentControl"
                Content="{Binding ListContent}"
                Margin="0" />

        </Border>

    </Grid>

</UserControl>