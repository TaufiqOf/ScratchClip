<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:viewModels="clr-namespace:ScratchClip.ViewModels"
    x:Class="ScratchClip.Views.Page.MainPageControl"
    x:DataType="viewModels:MainViewModel">

    <Grid
        RowDefinitions="Auto,Auto,Auto,*"
        Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

        <!-- ========================================================= -->
        <!-- Top toolbar                                                -->
        <!-- ========================================================= -->

        <Border
            Grid.Row="0"
            Padding="10,8">

            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Application -->
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="8">

                    <Border
                        Width="32"
                        Height="32"
                        CornerRadius="7"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">

                        <Image
                            x:Name="LogoImage"
                            Source="avares://ScratchClip/Assets/icon-dark.ico"
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stretch="Uniform"/>
                    </Border>

                    <TextBlock
                        Text="SCRATCHCLIP"
                        FontSize="15"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

                </StackPanel>


                <!-- Main actions -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="3"
                    Margin="16,0">

                    <!-- Clear clipboard -->
                    <Button
                        Command="{Binding ClearClipboardCommand}"
                        ToolTip.Tip="Clear Clipboard">

                        <avalonia:FluentIcon
                            Icon="ClipboardChatEmpty"
                            FontSize="16"/>

                    </Button>


                    <!-- Clear history -->
                    <Button
                        Command="{Binding ClearHistoryCommand}"
                        ToolTip.Tip="Clear Clipboard History">

                        <avalonia:FluentIcon
                            Icon="Delete"
                            FontSize="16"/>

                    </Button>


                    <!-- Lock -->
                    <Button
                        x:Name="LockButton"
                        Command="{Binding LockCommand}"
                        ToolTip.Tip="Lock Clipboard">

                        <avalonia:FluentIcon
                            Icon="LockClosed"
                            FontSize="16"/>

                    </Button>


                    <!-- Separator -->
                    <Border
                        Width="1"
                        Height="22"
                        Margin="6,0"
                        Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>


                    <!-- Clipboard monitoring -->
                    <ToggleButton
                        IsChecked="{Binding IsMonitoringClipboard}"
                        ToolTip.Tip="Toggle Clipboard Monitoring">

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6">

                            <avalonia:FluentIcon
                                Icon="Eye"
                                FontSize="16"/>

                            <TextBlock
                                Text="Monitor"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </ToggleButton>


                    <!-- Pin -->
                    <ToggleButton
                        IsChecked="{Binding IsPinned}"
                        ToolTip.Tip="Toggle Pinned">

                        <avalonia:FluentIcon
                            Icon="Pin"
                            FontSize="16"/>

                    </ToggleButton>


                    <!-- Mode -->
                    <ComboBox
                        ItemsSource="{Binding ModeOptions}"
                        SelectedItem="{Binding SelectedMode}"
                        MinWidth="110"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"/>

                </StackPanel>


                <!-- Settings -->
                <Button
                    Grid.Column="2"
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding OpenSettingsCommand}"
                    ToolTip.Tip="Settings">

                    <avalonia:FluentIcon
                        Icon="Settings"
                        FontSize="17"/>

                </Button>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- Toolbar separator                                          -->
        <!-- ========================================================= -->

        <Border
            Grid.Row="1"
            Height="1"
            Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>


        <!-- ========================================================= -->
        <!-- Filter / Search                                            -->
        <!-- ========================================================= -->

        <Border
            Grid.Row="2"
            Padding="10,8">

            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Tag filter -->
                <Grid
                    Grid.Column="0"
                    ColumnDefinitions="*,Auto"
                    Margin="0,0,10,0">

                    <DropDownButton
                        Grid.Column="0"
                        MinWidth="180"
                        HorizontalAlignment="Stretch"
                        Content="{Binding SelectedTagsSummary}">

                        <DropDownButton.Flyout>

                            <Flyout
                                Placement="BottomEdgeAlignedLeft">

                                <Border
                                    Padding="10"
                                    MinWidth="240"
                                    MaxHeight="280"
                                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

                                    <ScrollViewer
                                        MaxHeight="260">

                                        <ItemsControl
                                            ItemsSource="{Binding TagFilterOptions}">

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <CheckBox
                                                        Content="{Binding Name}"
                                                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                        Margin="2,4"/>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </ScrollViewer>

                                </Border>

                            </Flyout>

                        </DropDownButton.Flyout>

                    </DropDownButton>


                    <Button
                        Grid.Column="1"
                        Width="34"
                        Height="34"
                        Margin="4,0,0,0"
                        Command="{Binding ClearTagFilterCommand}"
                        ToolTip.Tip="Clear Tag Filter">

                        <avalonia:FluentIcon
                            Icon="Dismiss"
                            FontSize="15"/>

                    </Button>

                </Grid>


                <!-- Search -->
                <Grid
                    Grid.Column="1"
                    MinWidth="180"
                    MaxWidth="600"
                    HorizontalAlignment="Stretch"
                    ColumnDefinitions="*,Auto">

                    <TextBox
                        x:Name="SearchTextBox"
                        Grid.Column="0"
                        Height="36"
                        Text="{Binding SearchText, Mode=TwoWay}"
                        Watermark="Search clipboard history..."
                        VerticalContentAlignment="Center"/>

                    <Button
                        Grid.Column="1"
                        Width="34"
                        Height="34"
                        Margin="-38,0,2,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding ClearSearchCommand}"
                        ToolTip.Tip="Clear Search">

                        <avalonia:FluentIcon
                            Icon="Dismiss"
                            FontSize="14"/>

                    </Button>

                </Grid>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- Content separator                                          -->
        <!-- ========================================================= -->

        <Border
            Grid.Row="3"
            Background="{DynamicResource SystemControlBackgroundAltLowBrush}"/>


        <!-- ========================================================= -->
        <!-- Clipboard content                                          -->
        <!-- ========================================================= -->

        <ContentControl
            Grid.Row="3"
            Content="{Binding ListContent}"
            Margin="4,0"/>

    </Grid>

</UserControl>