<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             xmlns:viewModels="clr-namespace:ScratchClip.ViewModels"
             x:Class="ScratchClip.Views.Page.SettingPageControl"
             x:DataType="viewModels:SettingsViewModel">
    <Grid Margin="16" RowDefinitions="*,Auto">
        <StackPanel Grid.Row="0" Spacing="16">
            <TextBlock Text="Global Shortcut" FontSize="16" FontWeight="SemiBold" />

            <StackPanel Spacing="8">
                <TextBlock Text="Press a key combination to show the application window:"
                           Foreground="#888888" FontSize="12" TextWrapping="Wrap" />

                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="HotkeyTextBox"
                             Grid.Column="0"
                             IsReadOnly="True"
                             Text="{Binding HotkeyDisplay, Mode=OneWay}"
                             PlaceholderText="Click here and press shortcut..."
                             KeyDown="HotkeyTextBox_OnKeyDown" />

                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Command="{Binding ClearHotkeyCommand}"
                            ToolTip.Tip="Reset to default">
                        <avalonia:FluentIcon Icon="Dismiss" FontSize="14" />
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*">
                    <CheckBox IsChecked="{Binding IsAutoStartEnabled}"
                              Content="Start application on system startup"
                              VerticalAlignment="Center" />

                </Grid>

            </StackPanel>
            <StackPanel Spacing="8">
                <Grid RowDefinitions="Auto,Auto">
                    <CheckBox IsChecked="{Binding IsSaveHistoryOnExitEnabled}"
                              Content="Save clipboard history on exit"
                              VerticalAlignment="Center" />
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
                        <TextBlock Text="Max items in history:" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1"
                                       x:Name="MaxItemsInHistory"
                                       Increment="1"
                                       Value="{Binding MaximumItemsInHistory, Mode=TwoWay}"
                                       Maximum="300"
                                       Minimum="20"></NumericUpDown>
                    </Grid>
                </Grid>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="OnCancelClick" IsCancel="True" />
            <Button Content="Save" Click="OnSaveClick" IsDefault="True" Classes="accent" />
        </StackPanel>
    </Grid>
</UserControl>