<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:viewModels="clr-namespace:ScratchClip.ViewModels"
    x:Class="ScratchClip.Views.Page.SettingPageControl"
    x:DataType="viewModels:SettingsViewModel">

    <Grid Margin="10" RowDefinitions="Auto,*,Auto">
        <Border
            Margin="0,0,0,5"
            Padding="0,0,0,5"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock
                    Text="SETTINGS"
                    FontSize="26"
                    FontWeight="SemiBold" />

                <TextBlock
                    Text="Configure how ScratchClip behaves."
                    Opacity="0.65"
                    FontSize="13" />
            </StackPanel>
        </Border>

        <!-- Settings content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel
                MaxWidth="700"
                HorizontalAlignment="Stretch"
                Spacing="24">


                <!-- General -->
                <StackPanel Spacing="12">

                    <TextBlock
                        Text="General"
                        FontSize="16"
                        FontWeight="SemiBold" />

                    <Border
                        Padding="16"
                        CornerRadius="8"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">

                        <StackPanel Spacing="16">

                            <!-- Auto start -->
                            <Grid ColumnDefinitions="*,Auto">

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="2">

                                    <TextBlock
                                        Text="Start on system startup"
                                        FontWeight="Medium" />

                                    <TextBlock
                                        Text="Automatically start ScratchClip when you sign in."
                                        FontSize="12"
                                        Opacity="0.65"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsChecked="{Binding IsAutoStartEnabled}"
                                    VerticalAlignment="Center" />

                            </Grid>

                            <!-- Reverse order -->
                            <Grid ColumnDefinitions="*,Auto">

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="2">

                                    <TextBlock
                                        Text="Reverse order"
                                        FontWeight="Medium" />

                                    <TextBlock
                                        Text="Index of the most recent clipboard items is 1, and the oldest is the number of items."
                                        FontSize="12"
                                        Opacity="0.65"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsChecked="{Binding IsReverseOrder}"
                                    VerticalAlignment="Center" />

                            </Grid>

                            <!-- Save history -->
                            <Grid ColumnDefinitions="*,Auto">

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="2">

                                    <TextBlock
                                        Text="Save clipboard history on exit"
                                        FontWeight="Medium" />

                                    <TextBlock
                                        Text="Keep your clipboard history when ScratchClip closes."
                                        FontSize="12"
                                        Opacity="0.65"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsChecked="{Binding IsSaveHistoryOnExitEnabled}"
                                    VerticalAlignment="Center" />

                            </Grid>


                            <!-- Maximum history -->
                            <Grid
                                ColumnDefinitions="*,Auto"
                                Margin="0,4,0,0">

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="2">

                                    <TextBlock
                                        Text="Maximum history items"
                                        FontWeight="Medium" />

                                    <TextBlock
                                        Text="Choose how many clipboard items ScratchClip keeps."
                                        FontSize="12"
                                        Opacity="0.65"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <NumericUpDown
                                    Grid.Column="1"
                                    Width="150"
                                    x:Name="MaxItemsInHistory"
                                    Increment="1"
                                    Value="{Binding MaximumItemsInHistory, Mode=TwoWay}"
                                    Maximum="300"
                                    Minimum="20"
                                    VerticalAlignment="Center" />

                            </Grid>

                        </StackPanel>
                    </Border>

                </StackPanel>


                <!-- Shortcuts -->
                <StackPanel Spacing="12">

                    <TextBlock
                        Text="Keyboard shortcuts"
                        FontSize="16"
                        FontWeight="SemiBold" />

                    <Border
                        Padding="16"
                        CornerRadius="8"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">

                        <StackPanel Spacing="12">

                            <TextBlock
                                Text="Global shortcut"
                                FontWeight="Medium" />

                            <TextBlock
                                Text="Press a key combination to show the ScratchClip window."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />

                            <Grid
                                Margin="0,8,0,0"
                                ColumnDefinitions="*,Auto">

                                <TextBox
                                    x:Name="HotkeyTextBox"
                                    Grid.Column="0"
                                    VerticalContentAlignment="Center"
                                    IsReadOnly="True"
                                    Text="{Binding HotkeyDisplay, Mode=OneWay}"
                                    PlaceholderText="Click here and press a shortcut..."
                                    KeyDown="HotkeyTextBox_OnKeyDown" />

                                <Button
                                    Grid.Column="1"
                                    Width="38"
                                    Height="38"
                                    Margin="8,0,0,0"
                                    Command="{Binding ClearHotkeyCommand}"
                                    ToolTip.Tip="Reset shortcut">

                                    <avalonia:FluentIcon
                                        Icon="Dismiss"
                                        Width="16"
                                        Height="16" />

                                </Button>

                            </Grid>
                            <Grid
                                Margin="0,8,0,0"
                                ColumnDefinitions="*,Auto">

                                <TextBox
                                    x:Name="HotkeyMenuTextBox"
                                    Grid.Column="0"
                                    VerticalContentAlignment="Center"
                                    IsReadOnly="True"
                                    Text="{Binding HotkeyMenuDisplay, Mode=OneWay}"
                                    PlaceholderText="Click here and press a shortcut..."
                                    KeyDown="HotkeyMenuTextBox_OnKeyDown" />

                                <Button
                                    Grid.Column="1"
                                    Width="38"
                                    Height="38"
                                    Margin="8,0,0,0"
                                    Command="{Binding ClearHotkeyMenuCommand}"
                                    ToolTip.Tip="Reset shortcut">

                                    <avalonia:FluentIcon
                                        Icon="Dismiss"
                                        Width="16"
                                        Height="16" />

                                </Button>

                            </Grid>
                            <Separator Margin="0,4" />

                            <TextBlock
                                Text="Available shortcuts"
                                FontWeight="Medium" />

                            <Grid
                                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                RowSpacing="8"
                                ColumnSpacing="20">
                                <!--Main Screen General-->
                                <Grid Grid.Row="0"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                      ColumnDefinitions="200,*">
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2">
                                        <Run>Main Screen</Run>
                                        <Run FontSize="10">General Navigation</Run>
                                    </TextBlock>
                                    <!-- Alt + S -->
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Text="Alt + S"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="Focus the search input field"
                                        TextWrapping="Wrap" />

                                    <!-- Alt + Up Or Down -->
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Text="Alt + Up Or Down"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Text="Focus the Item List"
                                        TextWrapping="Wrap" />
                                    <!-- Alt + L -->
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Text="Alt + L"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Text="Lock the application, if the password is set."
                                        TextWrapping="Wrap" />

                                    <!-- Alt + Q -->
                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Text="Alt + Q"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Text="Pin/Unpin main screen to the top of the screen."
                                        TextWrapping="Wrap" />
                                    <!-- Alt + M -->
                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Text="Alt + M"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Text="Toggle Clipboard Monitoring On/Off."
                                        TextWrapping="Wrap" />
                                    
                                    <!-- Alt + P -->
                                    <TextBlock
                                        Grid.Row="6"
                                        Grid.Column="0"
                                        Text="Alt + P"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        Text="Show Preferences Screen"
                                        TextWrapping="Wrap" />
                                    <!-- 1 - 200 -->
                                    <TextBlock
                                        Grid.Row="7"
                                        Grid.Column="0"
                                        Text="1 – 200"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        Grid.Row="7"
                                        Grid.Column="1"
                                        Text="Instantly choose the corresponding item in the visible list and paste it"
                                        TextWrapping="Wrap" />

                                    <!-- Escape -->
                                    <TextBlock
                                        Grid.Row="8"
                                        Grid.Column="0"
                                        Text="Esc"
                                        FontWeight="SemiBold" />
                                    
                                    <TextBlock
                                        Grid.Row="8"
                                        Grid.Column="1"
                                        Text="Hide the window to the system tray, if in the Preference or edit screen, go back to the main screen"
                                        TextWrapping="Wrap" />

                                </Grid>
                                <Separator Grid.Row="1" Margin="0,4" />
                                <Grid Grid.Row="2"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                      ColumnDefinitions="200,*">
                       
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Grid.ColumnSpan="2">
                                        <Run >Main Screen</Run>
                                        <Run FontSize="10">Focused On List</Run>
                                    </TextBlock>
                                    <!-- Enter -->
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Text="Enter"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="Copy the selected item and paste it into the previously focused application. If focus is on the Search Input, focus the Item List."
                                        TextWrapping="Wrap" />

                                    <!-- Double Click -->
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Text="Double Click"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Text="Copy the selected item and paste it into the previously focused application"
                                        TextWrapping="Wrap" />
                                    <!-- Ctrl + E -->
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Text="Ctrl + E"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Text="Edit Selected Item"
                                        TextWrapping="Wrap" />
                                    
                                    <!-- Ctrl + S -->
                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Text="Ctrl + S"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Text="Save the focused item to a file."
                                        TextWrapping="Wrap" />
                                    <!-- Ctrl + 0 -->
                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Text="Ctrl + 0"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Text="Save the file in a temporary folder and open it with the default application. if its a file or folder open it with file manager"
                                        TextWrapping="Wrap" />
                                    
                                    <!-- Delete -->
                                    <TextBlock
                                        Grid.Row="6"
                                        Grid.Column="0"
                                        Text="Delete"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        Text="Delete Selected Item"
                                        TextWrapping="Wrap" />
                                </Grid>
                                <Separator Grid.Row="3" Margin="0,4" />
                                <Grid Grid.Row="4"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                      ColumnDefinitions="200,*">
                       
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Grid.ColumnSpan="2">
                                        <Run >Edit and Preferences Screen</Run>
                                        <Run FontSize="10">General</Run>
                                    </TextBlock>
                                    <!-- Ctrl + S -->
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Text="Ctrl + S"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="Save and return to main screen"
                                        TextWrapping="Wrap" />
                                    <!-- Escape -->
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Text="Esc"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Text="Return to main screen"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>


                <!-- Security -->
                <StackPanel Spacing="12">

                    <TextBlock
                        Text="Security"
                        FontSize="16"
                        FontWeight="SemiBold" />

                    <Border
                        Padding="16"
                        CornerRadius="8"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">

                        <StackPanel Spacing="14">

                            <!-- Header -->
                            <StackPanel Spacing="3">

                                <TextBlock
                                    Text="Application password"
                                    FontWeight="Medium"
                                    FontSize="14" />

                                <TextBlock
                                    Text="Protect your clipboard history with a password."
                                    FontSize="12"
                                    Opacity="0.65"
                                    TextWrapping="Wrap" />

                            </StackPanel>


                            <!-- Password fields -->
                            <StackPanel Spacing="8">

                                <TextBox
                                    x:Name="PasswordTextBox"
                                    PasswordChar="•"
                                    PlaceholderText="Password" />

                                <TextBox
                                    x:Name="ConfirmPasswordTextBox"
                                    PasswordChar="•"
                                    PlaceholderText="Confirm password" />

                            </StackPanel>


                            <!-- Error / status -->
                            <TextBlock
                                x:Name="PasswordStatusText"
                                FontSize="12"
                                IsVisible="False"
                                TextWrapping="Wrap" />


                            <!-- Actions -->
                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">

                                <Button
                                    x:Name="DeletePasswordButton"
                                    Content="Delete password"
                                    Click="DeletePasswordButtonOnClick"
                                    IsVisible="False" />

                                <Button
                                    x:Name="SetPasswordButton"
                                    Content="Set password"
                                    Click="SetPasswordButtonOnClick"
                                    Classes="accent" />

                            </StackPanel>


                            <!-- Information -->
                            <TextBlock
                                Text="Your password is stored securely using the system credential store."
                                FontSize="11"
                                Opacity="0.5"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </Border>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>


        <!-- Bottom actions -->
        <Border
            Grid.Row="2"
            Margin="0,5,0,0"
            Padding="0,5,0,0"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">

                <Button
                    Content="Cancel"
                    Click="OnCancelClick"
                    Width="100"
                    IsCancel="True" />

                <Button
                    Content="Save"
                    Click="OnSaveClick"
                    IsDefault="True"
                    Width="100"
                    Classes="accent" />

            </StackPanel>

        </Border>

    </Grid>

</UserControl>