<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:viewModels="clr-namespace:ScratchClip.ViewModels"
    xmlns:settingsControls="clr-namespace:ScratchClip.Views.Controls.SettingsControls"
    x:Class="ScratchClip.Views.Page.SettingPageControl"
    x:DataType="viewModels:SettingsViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.settingTitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="TextBlock.description">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.settingsCard">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        </Style>
        <Style Selector="Button.actionButton">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,8" />
        </Style>

        <!-- Keycap Chip Style for Keyboard Shortcuts -->
        <Style Selector="Border.keyBadge">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.keyBadge TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Monospace" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Margin="20"
                Padding="0,0,0,12"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Spacing="4">
                <TextBlock Text="Settings"
                           FontSize="24"
                           FontWeight="Bold" />
                <TextBlock Text="Configure how ScratchClip behaves."
                           Classes="description"
                           FontSize="13" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <Grid Grid.Column="0" RowDefinitions="*,Auto,*" Margin="10">
                <StackPanel Orientation="Vertical" Grid.Row="1">

                    <Button ToolTip.Tip="General"
                            Classes="settingsNavButton"
                            Tag="{Binding #GeneralSection}"
                            Click="SettingsNavButton_Click">
                        <avalonia:FluentIcon Icon="Settings" />
                    </Button>

                    <Button ToolTip.Tip="Monitor"
                            Classes="settingsNavButton"
                            Tag="{Binding #MonitorSection}"
                            Click="SettingsNavButton_Click">
                        <avalonia:FluentIcon Icon="Eye" />
                    </Button>

                    <Button ToolTip.Tip="Keyboard Shortcuts"
                            Classes="settingsNavButton"
                            Tag="{Binding #ShortcutsSection}"
                            Click="SettingsNavButton_Click">
                        <avalonia:FluentIcon Icon="Keyboard" />
                    </Button>

                    <Button ToolTip.Tip="Security"
                            Classes="settingsNavButton"
                            Tag="{Binding #SecuritySection}"
                            Click="SettingsNavButton_Click">
                        <avalonia:FluentIcon Icon="Key" />
                    </Button>
                    <Button ToolTip.Tip="Language Detection"
                            Classes="settingsNavButton"
                            Tag="{Binding #LanguageSection}"
                            Click="SettingsNavButton_Click">
                        <avalonia:FluentIcon Icon="LocalLanguage" />
                    </Button>
                    <Button ToolTip.Tip="Export"
                            Classes="settingsNavButton"
                            Tag="{Binding #ExportSection}"
                            Click="SettingsNavButton_Click">
                        <avalonia:FluentIcon Icon="ArrowExport" />
                    </Button>

                </StackPanel>
            </Grid>

            <!-- Settings Content -->
            <ScrollViewer x:Name="SettingsScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="720"
                            HorizontalAlignment="Stretch"
                            Spacing="24"
                            Margin="0,0,12,0">

                    <!-- General -->
                 
                    <StackPanel x:Name="GeneralSection" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <avalonia:FluentIcon Icon="Settings"></avalonia:FluentIcon>
                            <TextBlock Text="General" Classes="sectionTitle" />
                        </StackPanel>
                        <settingsControls:GeneralSettingsControl DataContext="{Binding }" />
                    </StackPanel>

                    <!-- Monitor -->
                    <StackPanel x:Name="MonitorSection" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <avalonia:FluentIcon Icon="Eye"></avalonia:FluentIcon>
                            <TextBlock Text="Monitor" Classes="sectionTitle" />
                        </StackPanel>

                        <settingsControls:MonitorSettingsControl DataContext="{Binding }" />
                    </StackPanel>

                    <!-- Shortcuts -->
                    <StackPanel x:Name="ShortcutsSection" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <avalonia:FluentIcon Icon="Keyboard"></avalonia:FluentIcon>
                            <TextBlock Text="Keyboard Shortcuts" Classes="sectionTitle" />
                        </StackPanel>
                        <settingsControls:KeyboardSettingsControl DataContext="{Binding }"/>

              
                    </StackPanel>

                    <!-- Security -->
                    <StackPanel x:Name="SecuritySection" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <avalonia:FluentIcon Icon="Key"></avalonia:FluentIcon>
                            <TextBlock Text="Security" Classes="sectionTitle" />
                        </StackPanel>

                        <settingsControls:SecuritySettingsControl DataContext="{Binding }" />
                    </StackPanel>
                    <!-- Language -->
                    <StackPanel x:Name="LanguageSection" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <avalonia:FluentIcon Icon="LocalLanguage"></avalonia:FluentIcon>
                            <TextBlock Text="Language Detection" Classes="sectionTitle" />
                        </StackPanel>

                        <settingsControls:LanguageSettingsControl DataContext="{Binding }" />
                    </StackPanel>
                    <!-- Export Data -->
                    <StackPanel x:Name="ExportSection" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <avalonia:FluentIcon Icon="ArrowExport"></avalonia:FluentIcon>
                            <TextBlock Text="Export Data" Classes="sectionTitle" />
                        </StackPanel>
                        <settingsControls:ExportSettingsControl DataContext="{Binding }"></settingsControls:ExportSettingsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <!-- Bottom Actions Footer -->
        <Border Grid.Row="2"
                Margin="20,12,20,20"
                Padding="0,12,0,0"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Click="OnCancelClick"
                        Classes="actionButton"
                        MinWidth="100"
                        IsCancel="True">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <avalonia:FluentIcon Icon="Dismiss" />
                        <TextBlock Text="Cancel" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Click="OnSaveClick"
                        IsDefault="True"
                        MinWidth="100"
                        Classes="actionButton accent">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <avalonia:FluentIcon Icon="Checkmark" />
                        <TextBlock Text="Save" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>