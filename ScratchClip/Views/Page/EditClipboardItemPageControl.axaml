<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             xmlns:models="clr-namespace:ScratchClip.Models"
             xmlns:controls="clr-namespace:ScratchClip.Views.Controls"
             xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
             xmlns:converters="clr-namespace:ScratchClip.Converters"
             x:Class="ScratchClip.Views.Page.EditClipboardItemPageControl"
             x:DataType="models:TextClipboardItem">

    <Grid Margin="10"
          RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0"
                Margin="0,0,0,10"
                Padding="0,0,0,8"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">

            <StackPanel Spacing="4">

                <TextBlock Text="EDIT CLIPBOARD ITEM"
                           FontSize="26"
                           FontWeight="SemiBold" />

                <TextBlock Text="Edit the contents and tags of this clipboard item."
                           Opacity="0.65"
                           FontSize="13" />

            </StackPanel>
        </Border>


        <!-- Main content -->
        <Grid Grid.Row="1"
              RowDefinitions="Auto,*,Auto">

            <!-- Tags -->
            <StackPanel Grid.Row="0"
                        Spacing="12">
                <TextBlock Text="Tags"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <Border Padding="16"
                        CornerRadius="8"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                    <StackPanel Spacing="10">
                        <controls:TagEditorControl
                            x:Name="TagEditor"
                            Tags="{Binding Tags, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>


            <!-- Content - takes remaining height -->
            <Grid Grid.Row="1"
                  RowDefinitions="Auto,*"
                  Margin="0,12">

                <TextBlock Grid.Row="0"
                           Text="Content"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />

                <Border Grid.Row="1"
                        Padding="16"
                        CornerRadius="8"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">

                    <!-- IMPORTANT: Grid, not StackPanel -->
                    <Grid RowDefinitions="Auto,*">

                        <avaloniaEdit:TextEditor
                            Grid.Row="1"
                            x:Name="ContentTextBox"
                            x:CompileBindings="False"
                            ShowLineNumbers="True"
                            FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                            FontSize="12"
                            Padding="8"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">

                            <Interaction.Behaviors>

                                <converters:TextEditorBindingBehavior
                                    Text="{Binding Text, Mode=TwoWay}" />

                            </Interaction.Behaviors>

                        </avaloniaEdit:TextEditor>

                    </Grid>

                </Border>

            </Grid>


            <!-- Information -->
            <StackPanel Grid.Row="2"
                        Spacing="12">

                <TextBlock Text="Information"
                           FontSize="16"
                           FontWeight="SemiBold" />

                <Border Padding="16"
                        CornerRadius="8"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">

                    <StackPanel Spacing="8">

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock Text="Created"
                                       FontWeight="Medium" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Timestamp,
                                          StringFormat='{}{0:HH:mm:ss - MMM dd, yyyy}'}"
                                       Opacity="0.65" />

                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock Text="Display index"
                                       FontWeight="Medium" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayIndex}"
                                       Opacity="0.65" />

                        </Grid>

                    </StackPanel>

                </Border>

            </StackPanel>

        </Grid>


        <!-- Bottom Actions -->
        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="0,10,0,0"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">

                <Button Content="Cancel"
                        Click="OnCancelClick"
                        Width="100"
                        IsCancel="True" />

                <Button Content="Save"
                        Click="OnSaveClick"
                        IsDefault="True"
                        Width="100"
                        Classes="accent" />

            </StackPanel>

        </Border>

    </Grid>

</UserControl>