<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             xmlns:models="clr-namespace:XClip.Models"
             xmlns:helper="clr-namespace:XClip.Helper"
             xmlns:controls="clr-namespace:XClip.Views.Controls"
             xmlns:vm="clr-namespace:XClip.ViewModels"
             xmlns:textType="clr-namespace:XClip.Models.TextType"
             x:DataType="vm:MainViewModel"
             x:Class="XClip.Views.Page.MainPageControl">
    <UserControl.Resources>
        <!-- Clipboard Item Template Selector -->
        <!-- Clipboard Item Template Selector -->
        <helper:ClipboardItemTemplateSelector x:Key="ClipboardItemSelector">

            <!-- TEXT FORMAT TEMPLATE -->
            <DataTemplate x:Key="{x:Static models:ClipboardDataFormat.Text}" x:DataType="models:TextClipboardItem">
                <controls:TextItemControl />
            </DataTemplate>

            <!-- IMAGE FORMAT TEMPLATE -->
            <DataTemplate x:Key="{x:Static models:ClipboardDataFormat.Image}" x:DataType="textType:ImageClipboardItem">
                <controls:ImageItemControl />
            </DataTemplate>

            <!-- STORAGE ITEMS (FILES) TEMPLATE -->
            <DataTemplate x:Key="{x:Static models:ClipboardDataFormat.Storage}"
                          x:DataType="models:TextClipboardItem">
                <controls:StorageItemsControl />
            </DataTemplate>

        </helper:ClipboardItemTemplateSelector>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- Toolbar Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="8,8,8,4">
            <!-- Left Aligned Controls -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <Button Command="{Binding ClearClipboardCommand}" ToolTip.Tip="Clear Clipboard">
                    <avalonia:FluentIcon Icon="ClipboardChatEmpty" FontSize="16" />
                </Button>
                <Button Command="{Binding ClearHistoryCommand}" ToolTip.Tip="Clear Clipboard History">
                    <avalonia:FluentIcon Icon="Delete" FontSize="16" />
                </Button>
                

                <!-- Monitor Clipboard Toggle -->
                <ToggleButton IsChecked="{Binding IsMonitoringClipboard}"
                              ToolTip.Tip="Toggle Clipboard Monitoring">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <avalonia:FluentIcon Icon="Eye" FontSize="16" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>

            <!-- Right Aligned Settings Button -->
            <Button Grid.Column="1"
                    HorizontalAlignment="Right"
                    Command="{Binding OpenSettingsCommand}"
                    ToolTip.Tip="Settings">
                <avalonia:FluentIcon Icon="Settings" FontSize="16" />
            </Button>
        </Grid>
        <!-- Tag Filter -->
        <Grid Grid.Row="2" Margin="8,0,8,4" ColumnDefinitions="*,Auto">
            <DropDownButton Grid.Column="0"
                            MinWidth="180"
                            HorizontalAlignment="Stretch"
                            Content="{Binding SelectedTagsSummary}">
                <DropDownButton.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <Border Padding="8" MinWidth="220" MaxHeight="250">
                            <ScrollViewer MaxHeight="230">
                                <ItemsControl ItemsSource="{Binding TagFilterOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <Button Grid.Column="1"
                    Command="{Binding ClearTagFilterCommand}"
                    ToolTip.Tip="Clear Tag Filter"
                    Background="Transparent"
                    BorderThickness="0">
                <avalonia:FluentIcon Icon="Dismiss" FontSize="16" />
            </Button>
        </Grid>

        <!-- Search Input Box -->
        <Grid Grid.Row="1" Margin="8,4" ColumnDefinitions="*,Auto">
            <TextBox x:Name="SearchTextBox"
                     Grid.Column="0"
                     Text="{Binding SearchText, Mode=TwoWay}"
                     PlaceholderText="Search history (Ctrl+S)..." />
            <Button Grid.Column="1"
                    Command="{Binding ClearSearchCommand}"
                    ToolTip.Tip="Clear Search"
                    Background="Transparent"
                    BorderThickness="0">
                <avalonia:FluentIcon Icon="Dismiss" FontSize="16" />
            </Button>
        </Grid>


        <!-- Clipboard List -->
        <Grid Grid.Row="3" Margin="8,4,8,8">
            <ListBox
                x:Name="ListBox"
                ItemsSource="{Binding FilteredHistory}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                ItemTemplate="{StaticResource ClipboardItemSelector}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem" x:DataType="models:TextClipboardItem">
                        <!-- Remove default padding and margins applied by the Avalonia theme -->
                        <Setter Property="Padding" Value="5" />
                        <Setter Property="Margin" Value="5" />

                    </Style>
                </ListBox.Styles>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>