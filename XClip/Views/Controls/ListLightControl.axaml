<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             xmlns:models="clr-namespace:XClip.Models"
             xmlns:converters="clr-namespace:XClip.Converters"
             xmlns:vm="clr-namespace:XClip.ViewModels"
             xmlns:textType="clr-namespace:XClip.Models.TextType"
             x:DataType="vm:ListViewModel"
             x:Class="XClip.Views.Controls.ListLightControl">

    <UserControl.Resources>
        <converters:ToUpperConverter x:Key="ToUpperConverter" />
    </UserControl.Resources>

    <!-- Clipboard List -->
    <Grid Margin="6,2,6,6">
        <ListBox
            x:Name="ListBox"
            ItemsSource="{Binding FilteredHistory}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <ListBox.DataTemplates>
                <DataTemplate DataType="models:TextClipboardItem">
                    <Border Padding="8"
                            CornerRadius="6"
                            Background="{DynamicResource SystemControlBackgroundAltMediumBrush}">
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              ColumnDefinitions="Auto,*,Auto"
                              RowSpacing="4"
                              ColumnSpacing="8">
                            <Border Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Width="22"
                                    Height="22"
                                    CornerRadius="3"
                                    Background="{DynamicResource SystemControlHighlightAccentBrush}">
                                <TextBlock Text="{Binding DisplayIndex}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SystemControlHighlightAltBaseHighBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss - MMM dd}'}"
                                           FontSize="10"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Command="{Binding DeleteCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="3"
                                    Padding="4"
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Top"
                                    ToolTip.Tip="Delete Item">
                                <avalonia:FluentIcon Icon="Delete" FontSize="13" />
                            </Button>

                            <SelectableTextBlock Grid.Row="1"
                                                 Grid.Column="1"
                                                 Text="{Binding DisplayText}"
                                                 FontSize="12"
                                                 Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                                 TextWrapping="Wrap" />

                            <ItemsControl Grid.Row="2"
                                          Grid.Column="1"
                                          ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                CornerRadius="3"
                                                Padding="5,1">
                                            <TextBlock Text="{Binding Converter={StaticResource ToUpperConverter}}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </DataTemplate>

                <DataTemplate DataType="textType:ImageClipboardItem">
                    <Border Padding="8"
                            CornerRadius="6"
                            Background="{DynamicResource SystemControlBackgroundAltMediumBrush}">
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              ColumnDefinitions="Auto,*,Auto"
                              RowSpacing="4"
                              ColumnSpacing="8">
                            <Border Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Width="22"
                                    Height="22"
                                    CornerRadius="3"
                                    Background="{DynamicResource SystemControlHighlightAccentBrush}">
                                <TextBlock Text="{Binding DisplayIndex}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SystemControlHighlightAltBaseHighBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss - MMM dd}'}"
                                           FontSize="10"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Command="{Binding DeleteCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="3"
                                    Padding="4"
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Top"
                                    ToolTip.Tip="Delete Item">
                                <avalonia:FluentIcon Icon="Delete" FontSize="13" />
                            </Button>

                            <Border Grid.Row="1"
                                    Grid.Column="1"
                                    Padding="4"
                                    CornerRadius="4"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                <Image Source="{Binding Image}"
                                       Height="64"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Left" />
                            </Border>

                            <ItemsControl Grid.Row="2"
                                          Grid.Column="1"
                                          ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                CornerRadius="3"
                                                Padding="5,1">
                                            <TextBlock Text="{Binding Converter={StaticResource ToUpperConverter}}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </DataTemplate>

                <DataTemplate DataType="models:StorageClipboardItem">
                    <Border Padding="8"
                            CornerRadius="6"
                            Background="{DynamicResource SystemControlBackgroundAltMediumBrush}">
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              ColumnDefinitions="Auto,*,Auto"
                              RowSpacing="4"
                              ColumnSpacing="8">
                            <Border Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Width="22"
                                    Height="22"
                                    CornerRadius="3"
                                    Background="{DynamicResource SystemControlHighlightAccentBrush}">
                                <TextBlock Text="{Binding DisplayIndex}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SystemControlHighlightAltBaseHighBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                
                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss - MMM dd}'}"
                                           FontSize="10"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Command="{Binding DeleteCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="3"
                                    Padding="4"
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Top"
                                    ToolTip.Tip="Delete Item">
                                <avalonia:FluentIcon Icon="Delete" FontSize="13" />
                            </Button>

                            <SelectableTextBlock Grid.Row="1"
                                                 Grid.Column="1"
                                                 Text="{Binding Content}"
                                                 FontSize="12"
                                                 Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                                 TextWrapping="Wrap" />

                            <ItemsControl Grid.Row="2"
                                          Grid.Column="1"
                                          ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                CornerRadius="3"
                                                Padding="5,1">
                                            <TextBlock Text="{Binding Converter={StaticResource ToUpperConverter}}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.DataTemplates>

            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="2" />
                    <Setter Property="Margin" Value="2" />
                </Style>
            </ListBox.Styles>
        </ListBox>
    </Grid>
</UserControl>