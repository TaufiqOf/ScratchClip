<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             xmlns:converters="clr-namespace:XClip.Converters"
             xmlns:models="clr-namespace:XClip.Models"
             x:Class="XClip.Views.Controls.TextItemControl"
             x:DataType="models:TextClipboardItem">

    <UserControl.Resources>
        <converters:ToUpperConverter x:Key="ToUpperConverter" />
    </UserControl.Resources>

    <Border CornerRadius="4">
        <Grid RowDefinitions="*,Auto">
            <!-- Text Content -->
            <TextBlock Grid.Row="0"
                       FontSize="14"
                       Text="{Binding DisplayText}"
                       ToolTip.Tip="{Binding DisplayText}"
                       TextWrapping="Wrap" MaxLines="20" TextTrimming="CharacterEllipsis" />

            <!-- Bottom Bar -->
            <Border Grid.Row="1"
                    Margin="0,6,0,0"
                    Padding="4"
                    CornerRadius="4"
                    Background="{DynamicResource SystemControlBackgroundAltMediumBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <!-- Index Badge -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource SystemControlHighlightAccentBrush}"
                            CornerRadius="3"
                            Width="24" Height="24"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayIndex}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SystemControlHighlightAltBaseHighBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Format Tag & Timestamp -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="8,0"
                                VerticalAlignment="Center">
                        <Border Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                CornerRadius="3"
                                Padding="6,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Format, Converter={StaticResource ToUpperConverter}}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss - MMM dd}'}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Delete Button -->
                    <Button Grid.Column="2"
                            Command="{Binding DeleteCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="3"
                            Padding="5"
                            Width="26" Height="26"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            ToolTip.Tip="Delete Item">
                        <avalonia:FluentIcon Icon="Delete" FontSize="14" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>