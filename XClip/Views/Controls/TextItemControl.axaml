<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             xmlns:converters="clr-namespace:XClip.Converters"
             xmlns:models="clr-namespace:XClip.Models"
             x:Class="XClip.Views.Controls.TextItemControl"
             x:DataType="models:TextClipboardItem">

    <UserControl.Resources>
        <converters:ToUpperConverter x:Key="ToUpperConverter" />
    </UserControl.Resources>

    <Border CornerRadius="4">
        <Grid RowDefinitions="*,Auto">
            <StackPanel Grid.Row="0" Spacing="8">
                <TextBlock FontSize="14"
                           Text="{Binding DisplayText}"
                           ToolTip.Tip="{Binding DisplayText}"
                           TextWrapping="Wrap" MaxLines="20" TextTrimming="CharacterEllipsis" />

                <Button IsVisible="{Binding IsWebSite}"
                        Command="{Binding OpenWebsiteCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Open website">
                    <Border Padding="8"
                            CornerRadius="6"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding WebsiteTitle}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding WebsiteHost}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <TextBlock Text="{Binding WebsiteDescription}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       TextWrapping="Wrap"
                                       MaxLines="3"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Button>
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,6,0,0"
                    Padding="4"
                    CornerRadius="4"
                    Background="{DynamicResource SystemControlBackgroundAltMediumBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <!-- Index Badge -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource SystemControlHighlightAccentBrush}"
                            CornerRadius="3"
                            Width="24" Height="24"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayIndex}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SystemControlHighlightAltBaseHighBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Format Tag & Timestamp -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="8,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss - MMM dd}'}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   VerticalAlignment="Center" />
                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                            CornerRadius="3"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Converter={StaticResource ToUpperConverter}}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Delete Button -->
                    <Button Grid.Column="2"
                            Command="{Binding DeleteCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="3"
                            Padding="5"
                            Width="26" Height="26"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            ToolTip.Tip="Delete Item">
                        <avalonia:FluentIcon Icon="Delete" FontSize="14" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>