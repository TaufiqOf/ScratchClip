<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:XClip.Models"
             xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             x:Class="XClip.Views.Controls.TextTypeControls.TextTypeInfoControl"
             x:DataType="models:ATextType">
    <Border Padding="10"
            CornerRadius="8"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="10">

            <!-- Website Icon -->
            <Border Width="42"
                    Height="42"
                    CornerRadius="8"
                    VerticalAlignment="Top"
                    Background="Transparent">

                <Grid>
                    <avalonia:FluentIcon Icon="{Binding Icon}"
                                       FontSize="40"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />

                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding Text}"
                           FontSize="11"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>


