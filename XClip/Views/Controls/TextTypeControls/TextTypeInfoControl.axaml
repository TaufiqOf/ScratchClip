<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:XClip.Models"
             x:Class="XClip.Views.Controls.TextTypeControls.TextTypeInfoControl"
             x:DataType="models:ATextType">
    <Border Padding="8"
            CornerRadius="6"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <StackPanel Spacing="2">
            <TextBlock Text="{Binding DisplayName}"
                       FontWeight="SemiBold"
                       FontSize="13"
                       TextWrapping="Wrap" />
            <TextBlock Text="Detected text subtype"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>


