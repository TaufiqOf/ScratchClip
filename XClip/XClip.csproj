<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AssemblyVersion>v0.0.8</AssemblyVersion>
        <FileVersion>v0.0.8</FileVersion>
        <NeutralLanguage>en</NeutralLanguage>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AutoLaunch" Version="1.0.1" />
        <PackageReference Include="Avalonia" Version="12.1.2" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="FluentIcons.Avalonia" Version="2.1.339.1" />
        <PackageReference Include="FluentIcons.Avalonia.Fluent" Version="2.1.339.1" />
        <PackageReference Include="FuzzySharp" Version="2.0.2" />
        <PackageReference Include="SharpHook" Version="8.0.0" />
        <PackageReference Include="Tmds.DBus" Version="0.95.1" />
        <PackageReference Include="TreeSitter.DotNet" Version="1.3.0" />
        <PackageReference Include="Xaml.Behaviors.Avalonia" Version="*" />
        <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
        <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="ViewModels\MainViewModelCopy.cs" />
        <Compile Update="Views\Page\SettingPageControl.axaml.cs">
            <DependentUpon>SettingPageControl.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\Controls\TextTypeControls\PlainTextTypeControl.axaml.cs">
          <DependentUpon>PlainTextTypeControl.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\Controls\TextTypeControls\TextTypeInfoControl.axaml.cs">
          <DependentUpon>TextTypeInfoControl.axaml</DependentUpon>
        </Compile>
    </ItemGroup>
</Project>
